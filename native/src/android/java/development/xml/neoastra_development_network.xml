<?xml version="1.0" encoding="utf-8"?>
<!-- The network security of a debug build of an Android application: the development server of `dotnet neoastra dev` serves
     plain HTTP on the loopback address, which adb reverse forwards to the development machine. Nothing else is allowed in clear. -->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
