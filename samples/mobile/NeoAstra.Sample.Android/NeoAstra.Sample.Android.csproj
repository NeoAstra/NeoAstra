<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>dev.neoastra.sample.mobile</ApplicationId>
    <ApplicationTitle>NeoAstra</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <IsPackable>false</IsPackable>
    <!-- The keyboard lies over the page, which learns its height (the Keyboard card); Android reports it to an edge-to-edge
         window, which draws under the system bars while the page keeps clear of them with env(safe-area-inset-*). -->
    <NeoAstraAndroidKeyboardOverlay>true</NeoAstraAndroidKeyboardOverlay>
    <NeoAstraAndroidEdgeToEdge>true</NeoAstraAndroidEdgeToEdge>
    <TrimMode>full</TrimMode>
    <SampleWebAssets>Assets$([System.IO.Path]::DirectorySeparatorChar)web$([System.IO.Path]::DirectorySeparatorChar)</SampleWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/NeoAstra/NeoAstra.csproj" />
    <ProjectReference Include="../../../src/NeoAstra.Location/NeoAstra.Location.csproj" />
    <ProjectReference Include="../../../src/NeoAstra.Mcp/NeoAstra.Mcp.csproj" Condition="'$(Configuration)' == 'Debug'" />
    <ProjectReference Include="../../../src/NeoAstra.Push/NeoAstra.Push.csproj" />
    <ProjectReference Include="../../../src/NeoAstra.Passkeys/NeoAstra.Passkeys.csproj" />
    <ProjectReference Include="../../../src/NeoAstra.Purchases/NeoAstra.Purchases.csproj" />
    <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.17.0" />
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
    <PackageReference Include="Xamarin.AndroidX.Credentials" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" Version="1.6.0.2" />
    <PackageReference Include="Xamarin.Android.Google.BillingClient" Version="9.1.0.2" />
    <!-- The Firebase project of the push messages is local: without its google-services.json, or with NeoAstraSampleFirebase=false
         for an ApplicationId that the file does not have, push answers Unsupported. -->
    <GoogleServicesJson Include="google-services.json" Condition="Exists('google-services.json') And '$(NeoAstraSampleFirebase)' != 'false'" />
    <Compile Include="../Shared/*.cs" />
    <EmbeddedResource Include="../Shared/capabilities/main.json" LogicalName="capabilities.json" />
    <!-- The links use the separator of the platform: the build strips the Assets prefix only when it is followed by that
         separator, and a link written with '/' keeps an Assets folder in the APK on Windows. -->
    <AndroidAsset Include="../Shared/frontend/**/*" Link="$(SampleWebAssets)%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../../../frontend/packages/client/dist/*.js" Exclude="../../../frontend/packages/client/dist/testing.js" Link="$(SampleWebAssets)client$([System.IO.Path]::DirectorySeparatorChar)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Project references to the plugins take the targets that their packages give an Android application. -->
  <Import Project="../../../src/NeoAstra.Location/Build/NeoAstra.Location.targets" />
  <Import Project="../../../src/NeoAstra.Push/Build/NeoAstra.Push.targets" />
  <Import Project="../../../src/NeoAstra.Passkeys/Build/NeoAstra.Passkeys.targets" />
  <Import Project="../../../src/NeoAstra.Purchases/Build/NeoAstra.Purchases.targets" />
</Project>
