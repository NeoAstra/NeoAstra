<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>dev.neoastra.sample.mobile</ApplicationId>
    <ApplicationTitle>NeoAstra</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <IsPackable>false</IsPackable>
    <TrimMode>full</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/NeoAstra/NeoAstra.csproj" />
    <ProjectReference Include="../../../src/NeoAstra.Location/NeoAstra.Location.csproj" />
    <ProjectReference Include="../../../src/NeoAstra.Push/NeoAstra.Push.csproj" />
    <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.17.0" />
    <Compile Include="../Shared/*.cs" />
    <EmbeddedResource Include="../Shared/capabilities/main.json" LogicalName="capabilities.json" />
    <AndroidAsset Include="../Shared/frontend/**/*" Link="Assets/web/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../../../frontend/packages/client/dist/*.js" Exclude="../../../frontend/packages/client/dist/testing.js" Link="Assets/web/client/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- A project reference to the location plugin takes the targets that its package gives an Android application. -->
  <Import Project="../../../src/NeoAstra.Location/Build/NeoAstra.Location.targets" />
</Project>
