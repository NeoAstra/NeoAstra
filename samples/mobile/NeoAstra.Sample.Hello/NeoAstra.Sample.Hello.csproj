<Project Sdk="Microsoft.NET.Sdk">
  <!-- One project for both platforms: the application, its page in frontend/, and a folder of each platform. -->
  <PropertyGroup>
    <TargetFrameworks>net11.0-ios;net11.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>dev.neoastra.sample.hello</ApplicationId>
    <ApplicationTitle>NeoAstra Hello</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <TrimMode Condition="'$(Configuration)' == 'Release'">full</TrimMode>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <AndroidManifest>Platforms/Android/AndroidManifest.xml</AndroidManifest>
    <TrimMode>full</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/NeoAstra/NeoAstra.csproj" />
    <Compile Remove="Platforms/**" />
    <Compile Include="Platforms/iOS/**/*.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
    <Compile Include="Platforms/Android/**/*.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.17.0" />
  </ItemGroup>
  <Import Project="../../../src/NeoAstra/Build/Sdk/NeoAstra.props" />
  <Import Project="../../../src/NeoAstra/Build/Sdk/NeoAstra.Build.targets" />
</Project>
