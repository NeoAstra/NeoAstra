{
  "$schema": "neoastra-capabilities-v1.schema.json",
  "version": 1,
  "capabilities": [
    {
      "id": "mobile-main",
      "views": [
        "main"
      ],
      "platforms": [
        "ios",
        "android"
      ],
      "origins": [
        "app://neoastra"
      ],
      "permissions": [
        "haptics:play",
        "location:status",
        "location:read",
        "push:register",
        "push:receive",
        "push:foreground",
        "passkeys:create",
        "passkeys:get",
        "purchases:read",
        "purchases:buy",
        "purchases:finish",
        "system-info:theme",
        "system-info:metadata",
        "system-info:displays",
        {
          "id": "clipboard:read-text",
          "scope": {
            "formats": [
              "text"
            ],
            "operations": [
              "read"
            ]
          }
        },
        {
          "id": "clipboard:write-text",
          "scope": {
            "formats": [
              "text"
            ],
            "operations": [
              "write"
            ]
          }
        },
        "safe-storage:store",
        "safe-storage:retrieve",
        "safe-storage:delete",
        {
          "id": "opener:url",
          "scope": {
            "schemes": [
              "https"
            ],
            "hosts": [
              "github.com"
            ]
          }
        },
        "notifications:status",
        {
          "id": "notifications:display",
          "scope": {
            "appIdentity": "dev.neoastra.sample.mobile",
            "categories": [
              "general"
            ],
            "maximumPayloadBytes": 1024,
            "persistent": false,
            "urgencies": [
              "normal"
            ]
          }
        },
        "notifications:activation",
        {
          "id": "notifications:schedule",
          "scope": {
            "appIdentity": "dev.neoastra.sample.mobile",
            "categories": [
              "reminders"
            ],
            "maximumPayloadBytes": 1024,
            "persistent": false,
            "urgencies": [
              "normal"
            ]
          }
        },
        "notifications:unschedule",
        "notifications:request",
        "notifications:launch-activation",
        "dialogs:message",
        "window:management",
        "window:close",
        "window:polish",
        "tray:create"
      ]
    }
  ]
}
