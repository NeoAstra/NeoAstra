<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <NeoRpcJavaScriptOutput>$(MSBuildProjectDirectory)/assets/generated/neoastra.js</NeoRpcJavaScriptOutput>
    <NeoRpcJavaScriptImport>../neoastra-client/index.js</NeoRpcJavaScriptImport>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NeoAstra/NeoAstra.csproj" />
    <None Include="assets/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../src/NeoAstra/Build/Sdk/NeoAstra.props" />
  <Import Project="../../src/NeoAstra/Build/Sdk/NeoAstra.Build.targets" />
</Project>
