<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PublishAot>true</PublishAot><IsAotCompatible>true</IsAotCompatible><InvariantGlobalization>true</InvariantGlobalization>
    <NeoRpcTypeScriptOutput>$(MSBuildProjectDirectory)/ClientApp/src/generated/neoastra.ts</NeoRpcTypeScriptOutput>
    <NeoRpcManifestOutput>$(MSBuildProjectDirectory)/generated/neoastra.manifest.json</NeoRpcManifestOutput>
    <NeoRpcSchemaOutput>$(MSBuildProjectDirectory)/generated/neoastra.schema.json</NeoRpcSchemaOutput>
    <NeoAstraToolPath>$(MSBuildThisFileDirectory)../../src/NeoAstra.Tool/bin/$(Configuration)/net10.0/NeoAstra.Tool.dll</NeoAstraToolPath>
    <NeoAstraPrebuiltAssets>true</NeoAstraPrebuiltAssets><NeoAstraPrebuiltAssetDirectory>$(MSBuildProjectDirectory)/ClientApp/dist</NeoAstraPrebuiltAssetDirectory>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="NeoRpcTypeScriptOutput" /><CompilerVisibleProperty Include="NeoRpcManifestOutput" /><CompilerVisibleProperty Include="NeoRpcSchemaOutput" />
    <ProjectReference Include="../../src/NeoAstra/NeoAstra.csproj" />
    <ProjectReference Include="../../src/NeoAstra.Rpc/NeoAstra.Rpc.csproj" />
    <ProjectReference Include="../../src/NeoAstra.Desktop/NeoAstra.Desktop.csproj" />
    <ProjectReference Include="../../src/NeoAstra.Rpc.Generator/NeoAstra.Rpc.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot" />
    <ProjectReference Include="../../src/NeoAstra.Tool/NeoAstra.Tool.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot" />
    <None Include="capabilities/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="capabilities/%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="../../src/NeoAstra.Sdk/buildTransitive/NeoAstra.Sdk.props" />
  <Import Project="../../src/NeoAstra.Sdk/buildTransitive/NeoAstra.Sdk.targets" />
  <Target Name="NeoAstraCopyReferenceFrontend" AfterTargets="Build" DependsOnTargets="NeoAstraPrepareFrontend">
    <Copy SourceFiles="@(_NeoAstraAssetFile)" DestinationFiles="@(_NeoAstraAssetFile-&gt;'$(OutDir)assets/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
