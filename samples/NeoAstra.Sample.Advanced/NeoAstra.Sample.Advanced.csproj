<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NeoAstra/NeoAstra.csproj" />
    <NeoAstraFrontendInput Include="../../frontend/packages/client/package.json" />
    <NeoAstraFrontendInput Include="../../frontend/packages/client/tsconfig.json" />
    <NeoAstraFrontendInput Include="../../frontend/packages/client/src/**/*.ts" />
    <None
      Include="capabilities/*.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      Link="capabilities/%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="../../src/NeoAstra/Build/Sdk/NeoAstra.props" />
  <Import Project="../../src/NeoAstra/Build/Sdk/NeoAstra.Build.targets" />
</Project>
