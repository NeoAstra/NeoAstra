{
  "$schema": "neoastra-capabilities-v1.schema.json",
  "version": 1,
  "capabilities": [
    {
      "id": "main-feature-tour",
      "views": ["main"],
      "permissions": [
        "tour:read",
        "tour:control",
        "tour:events",
        {
          "id": "dialogs:open-file",
          "scope": {
            "kinds": ["openFile"],
            "initialLocations": ["assets"],
            "extensions": ["svg", "txt"]
          }
        },
        {
          "id": "dialogs:open-folder",
          "scope": {
            "kinds": ["openFolder"],
            "initialLocations": ["assets"]
          }
        },
        {
          "id": "dialogs:save-file",
          "scope": {
            "kinds": ["saveFile"],
            "initialLocations": ["assets"],
            "extensions": ["txt"]
          }
        },
        "dialogs:message",
        "menus:activate",
        "menus:control",
        "tray:create",
        "tray:control",
        {
          "id": "clipboard:read-text",
          "scope": {
            "formats": ["text"],
            "operations": ["read"]
          }
        },
        {
          "id": "clipboard:write-text",
          "scope": {
            "formats": ["text"],
            "operations": ["write"]
          }
        },
        "clipboard:clear",
        "notifications:status",
        {
          "id": "notifications:display",
          "scope": {
            "appIdentity": "org.neoastra.sample.advanced",
            "categories": ["tour"],
            "maximumPayloadBytes": 512,
            "urgencies": ["normal"]
          }
        },
        "notifications:remove",
        "notifications:activation",
        {
          "id": "shortcuts:register",
          "scope": {
            "accelerators": ["Ctrl+Shift+R"]
          }
        },
        "shortcuts:control",
        "system-info:theme",
        "system-info:displays",
        "system-info:metadata",
        {
          "id": "opener:url",
          "scope": {
            "schemes": ["https"],
            "hosts": ["github.com"],
            "ports": [443],
            "pathPrefixes": ["/NeoAstra/NeoAstra"]
          }
        },
        "drag-drop:outbound",
        "drag-drop:receive-files",
        "window:polish",
        "safe-storage:store",
        "safe-storage:retrieve",
        "safe-storage:delete"
      ]
    },
    {
      "id": "restricted-preview",
      "views": ["preview"],
      "permissions": [
        "tour:read",
        "tour:events"
      ]
    }
  ]
}
