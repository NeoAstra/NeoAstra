{
  "$schema": "neoastra-project-v1.schema.json",
  "version": 1,
  "app": {
    "identifier": "org.neoastra.sample.advanced",
    "displayName": "NeoAstra Advanced Sample"
  },
  "frontend": {
    "root": "ClientApp",
    "devCommand": [
      "npm",
      "run",
      "dev",
      "--",
      "--host",
      "127.0.0.1"
    ],
    "backendCommand": [
      "dotnet",
      "watch",
      "run"
    ],
    "devUrl": "http://127.0.0.1:5173",
    "buildCommand": [
      "npm",
      "run",
      "build"
    ],
    "dist": "ClientApp/dist",
    "spaFallback": "index.html",
    "packageManager": "npm",
    "lockfile": "ClientApp/package-lock.json",
    "generatedContract": "ClientApp/src/generated/neoastra.ts"
  },
  "assets": {
    "origin": "app://neoastra",
    "cacheHashedAssets": true,
    "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "capabilities": [
    "capabilities/main.json"
  ]
}
