<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Native contract tests call the native library with pointers, as NeoAstra.Core does. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    <None Include="Fixtures\window-icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoAstra\NeoAstra.csproj" />
    <ProjectReference Include="..\NeoAstra.SingleInstanceHelper\NeoAstra.SingleInstanceHelper.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NeoAstra.Generator\NeoAstra.Generator.csproj" />
    <ProjectReference Include="..\NeoAstra.Tool\NeoAstra.Tool.csproj" />
    <ProjectReference Include="..\..\samples\NeoAstra.Sample\NeoAstra.Sample.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
