<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the manifest of an Android application that references the Play Billing Library: the provider adds the purchases
     service to the platform services of NeoAstra when the process starts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <provider
        android:name="com.neoastra.purchases.NeoAstraPurchasesInitializer"
        android:authorities="${applicationId}.neoastra.purchases"
        android:exported="false" />
  </application>
</manifest>
