{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoastra.dev/schemas/desktop/clipboard.scope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formats", "operations"],
  "properties": {
    "formats": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["text", "html", "image", "files"] } },
    "operations": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["read", "write"] } }
  }
}
