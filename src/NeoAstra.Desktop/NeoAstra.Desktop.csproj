<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Static plugin contracts and capability-gated desktop services for NeoAstra.</Description>
    <PackageReadmeFile>docs/desktop-services.md</PackageReadmeFile>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/xoofx/NeoAstra</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NeoAstra\NeoAstra.csproj" />
    <ProjectReference Include="..\NeoAstra.Rpc\NeoAstra.Rpc.csproj" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="neoastra.plugin.json" />
    <EmbeddedResource Include="schemas\*.schema.json" />
    <None Update="neoastra.plugin.json" Pack="true" PackagePath="plugins/neoastra.desktop.essentials/" />
    <None Update="schemas\*.schema.json" Pack="true" PackagePath="plugins/neoastra.desktop.essentials/schemas/%(Filename)%(Extension)" />
    <None Include="$(MSBuildThisFileDirectory)..\..\license.txt" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)..\..\doc\desktop-services.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
