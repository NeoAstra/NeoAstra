<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>The complete NeoAstra desktop application platform with RPC, secure capabilities, desktop services, and hosting.</Description>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>NeoAstra.png</PackageIcon>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/NeoAstra/NeoAstra</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NeoAstra/NeoAstra</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NeoAstraGeneratorAssembly>$(MSBuildThisFileDirectory)..\NeoAstra.Generator\bin\$(Configuration)\netstandard2.0\NeoAstra.Generator.dll</NeoAstraGeneratorAssembly>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);NeoAstraCollectPackagedTool;NeoAstraCollectPackagedFrontendClient</TargetsForTfmSpecificContentInPackage>
    <NeoAstraFrontendClientSourceDirectory>$(MSBuildThisFileDirectory)..\..\frontend\packages\client</NeoAstraFrontendClientSourceDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoAstra.Core\NeoAstra.Core.csproj" />
    <ProjectReference Include="..\NeoAstra.Generator\NeoAstra.Generator.csproj" ReferenceOutputAssembly="false" />
    <!-- Build the packaged tool through the normal acyclic graph without copying or referencing it. -->
    <ProjectReference Include="..\NeoAstra.Tool\NeoAstra.Tool.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Desktop\neoastra.plugin.json" />
    <EmbeddedResource Include="Desktop\schemas\*.schema.json" />
    <None Update="Desktop\neoastra.plugin.json" Pack="true" PackagePath="plugins/neoastra.desktop.essentials/neoastra.plugin.json" />
    <None Update="Desktop\schemas\*.schema.json" Pack="true" PackagePath="plugins/neoastra.desktop.essentials/schemas/%(Filename)%(Extension)" />
    <None Include="Build\Sdk\NeoAstra.props" Pack="true" PackagePath="buildTransitive/NeoAstra.props" />
    <None Include="Build\Sdk\NeoAstra.Build.targets" Pack="true" PackagePath="buildTransitive/NeoAstra.targets" />
    <None Include="$(NeoAstraGeneratorAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(NeoAstraGeneratorAssembly).pdb" Condition="Exists('$(NeoAstraGeneratorAssembly).pdb')" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../../img/NeoAstra.png" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../readme.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../license.txt" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../doc/rpc-and-bindings.md" Pack="true" PackagePath="docs/" />
    <None Include="$(MSBuildThisFileDirectory)../../doc/capabilities-and-security.md" Pack="true" PackagePath="docs/" />
    <None Include="$(MSBuildThisFileDirectory)../../doc/security-threat-model.md" Pack="true" PackagePath="docs/" />
    <None Include="$(MSBuildThisFileDirectory)../../doc/desktop-services.md" Pack="true" PackagePath="docs/" />
    <None Include="$(MSBuildThisFileDirectory)../../doc/application-lifecycle-and-hosting.md" Pack="true" PackagePath="docs/" />
    <None Include="$(MSBuildThisFileDirectory)../../schemas/neoastra-capabilities-v1.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="$(MSBuildThisFileDirectory)../../schemas/neoastra-project-v1.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="$(MSBuildThisFileDirectory)../../schemas/neoastra-staging-manifest-v1.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="$(MSBuildThisFileDirectory)../../schemas/neoastra-update-manifest-v1.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="$(MSBuildThisFileDirectory)../../doc/frontend-tooling-and-assets.md" Pack="true" PackagePath="docs/" />
    <None Include="$(MSBuildThisFileDirectory)../../doc/codealta-integration.md" Pack="true" PackagePath="docs/" />
    <None Include="$(MSBuildThisFileDirectory)../../doc/delivery-and-updates.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>

  <Target Name="NeoAstraCollectPackagedTool">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\NeoAstra.Tool\bin\$(Configuration)\net10.0\NeoAstra.Tool.dll;
                                       $(MSBuildThisFileDirectory)..\NeoAstra.Tool\bin\$(Configuration)\net10.0\NeoAstra.Tool.deps.json;
                                       $(MSBuildThisFileDirectory)..\NeoAstra.Tool\bin\$(Configuration)\net10.0\NeoAstra.Tool.runtimeconfig.json;
                                       $(MSBuildThisFileDirectory)..\NeoAstra.Tool\bin\$(Configuration)\net10.0\XenoAtom.CommandLine.dll">
        <PackagePath>tools/net10.0/any/%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <_NeoAstraPackagedFrontendClientInput Include="$(NeoAstraFrontendClientSourceDirectory)\package.json" />
    <_NeoAstraPackagedFrontendClientInput Include="$(NeoAstraFrontendClientSourceDirectory)\tsconfig.json" />
    <_NeoAstraPackagedFrontendClientInput Include="$(NeoAstraFrontendClientSourceDirectory)\src\**\*.ts" />
    <_NeoAstraPackagedFrontendClientInput Include="$(NeoAstraFrontendClientSourceDirectory)\..\..\package.json" />
    <_NeoAstraPackagedFrontendClientInput Include="$(NeoAstraFrontendClientSourceDirectory)\..\..\package-lock.json" />
  </ItemGroup>

  <Target Name="NeoAstraBuildFrontendClient" BeforeTargets="Build"
          Inputs="@(_NeoAstraPackagedFrontendClientInput)"
          Outputs="$(NeoAstraFrontendClientSourceDirectory)\dist\index.js;$(NeoAstraFrontendClientSourceDirectory)\dist\index.d.ts;$(NeoAstraFrontendClientSourceDirectory)\dist\testing.js;$(NeoAstraFrontendClientSourceDirectory)\dist\testing.d.ts">
    <Exec WorkingDirectory="$(NeoAstraFrontendClientSourceDirectory)\..\.." Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(NeoAstraFrontendClientSourceDirectory)\..\.." Command="npm run build --workspace @neoastra/client" />
  </Target>

  <Target Name="NeoAstraCollectPackagedFrontendClient" DependsOnTargets="NeoAstraBuildFrontendClient">
    <ItemGroup>
      <_NeoAstraPackagedFrontendClientMetadata Include="$(NeoAstraFrontendClientSourceDirectory)\package.json;$(NeoAstraFrontendClientSourceDirectory)\LICENSE;$(NeoAstraFrontendClientSourceDirectory)\README.md;$(NeoAstraFrontendClientSourceDirectory)\provenance.json">
        <PackagePath>tools/frontend/neoastra-client/%(_NeoAstraPackagedFrontendClientMetadata.Filename)%(_NeoAstraPackagedFrontendClientMetadata.Extension)</PackagePath>
      </_NeoAstraPackagedFrontendClientMetadata>
      <_NeoAstraPackagedFrontendClientDist Include="$(NeoAstraFrontendClientSourceDirectory)\dist\**\*">
        <PackagePath>tools/frontend/neoastra-client/dist/%(_NeoAstraPackagedFrontendClientDist.RecursiveDir)%(_NeoAstraPackagedFrontendClientDist.Filename)%(_NeoAstraPackagedFrontendClientDist.Extension)</PackagePath>
      </_NeoAstraPackagedFrontendClientDist>
      <TfmSpecificPackageFile Include="@(_NeoAstraPackagedFrontendClientMetadata);@(_NeoAstraPackagedFrontendClientDist)" />
    </ItemGroup>
  </Target>
</Project>
