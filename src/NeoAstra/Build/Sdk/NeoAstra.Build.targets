<Project>
  <ItemGroup>
    <CompilerVisibleProperty Include="NeoRpcTypeScriptOutput" />
    <CompilerVisibleProperty Include="NeoRpcJavaScriptOutput" />
    <CompilerVisibleProperty Include="NeoRpcJavaScriptImport" />
    <CompilerVisibleProperty Include="NeoRpcManifestOutput" />
    <CompilerVisibleProperty Include="NeoRpcSchemaOutput" />
    <CompilerVisibleProperty Include="NeoRpcBaselineManifest" />
  </ItemGroup>

  <PropertyGroup>
    <_NeoAstraPrepareFrontend Condition="'$(NeoAstraFrontendEnabled)' == 'true' and ('$(NeoAstraBuildFrontend)' == 'true' or '$(NeoAstraPrebuiltAssets)' == 'true') and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">true</_NeoAstraPrepareFrontend>
    <_NeoAstraRestoreFrontend Condition="'$(_NeoAstraPrepareFrontend)' == 'true' and '$(NeoAstraPrebuiltAssets)' != 'true' and '$(NeoAstraRestoreFrontendDependencies)' == 'true'">true</_NeoAstraRestoreFrontend>
  </PropertyGroup>

  <Target Name="NeoAstraCollectRpcArtifacts"
          BeforeTargets="_GetCopyToOutputDirectoryItemsFromThisProject"
          DependsOnTargets="Compile">
    <ItemGroup>
      <ContentWithTargetPath Include="$(NeoRpcTypeScriptOutput)" Condition="Exists('$(NeoRpcTypeScriptOutput)')">
        <TargetPath>neoastra/$([System.IO.Path]::GetFileName('$(NeoRpcTypeScriptOutput)'))</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
      <ContentWithTargetPath Include="$(NeoRpcManifestOutput)" Condition="Exists('$(NeoRpcManifestOutput)')">
        <TargetPath>neoastra/$([System.IO.Path]::GetFileName('$(NeoRpcManifestOutput)'))</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
      <ContentWithTargetPath Include="$(NeoRpcSchemaOutput)" Condition="Exists('$(NeoRpcSchemaOutput)')">
        <TargetPath>neoastra/$([System.IO.Path]::GetFileName('$(NeoRpcSchemaOutput)'))</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

  <Target Name="NeoAstraVerifyContracts" AfterTargets="Compile"
          Condition="'$(NeoAstraFrontendEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and Exists('$(NeoRpcTypeScriptOutput)') and Exists('$(NeoRpcManifestOutput)')">
    <Exec Command="&quot;$(NeoAstraDotNetHost)&quot; exec &quot;$(NeoAstraToolPath)&quot; contract check --typescript &quot;$(NeoRpcTypeScriptOutput)&quot; --manifest &quot;$(NeoRpcManifestOutput)&quot;" />
  </Target>

  <Target Name="NeoAstraRestoreFrontendPackages" DependsOnTargets="Compile;NeoAstraVerifyContracts"
          Condition="'$(_NeoAstraRestoreFrontend)' == 'true'">
    <ItemGroup>
      <_NeoAstraFrontendRestoreOutput Remove="@(_NeoAstraFrontendRestoreOutput)" />
    </ItemGroup>
    <Exec Command="&quot;$(NeoAstraDotNetHost)&quot; exec &quot;$(NeoAstraToolPath)&quot; frontend restore --config &quot;$(NeoAstraProjectConfig)&quot;"
          ConsoleToMsBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_NeoAstraFrontendRestoreOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_NeoAstraFrontendRestoreExitCode" />
    </Exec>
    <Error Condition="'$(_NeoAstraFrontendRestoreExitCode)' != '0'"
           Code="NEOASTRA1001"
           Text="NeoAstra frontend dependency restore failed: @(_NeoAstraFrontendRestoreOutput, ' | ')" />
  </Target>

  <Target Name="NeoAstraStageFrontendClient"
          Condition="'$(NeoAstraStageFrontendClient)' == 'true'">
    <PropertyGroup>
      <_NeoAstraFrontendClientInputDirectory Condition="Exists('$(NeoAstraFrontendClientSourceDirectory)/package.json')">$(NeoAstraFrontendClientSourceDirectory)</_NeoAstraFrontendClientInputDirectory>
      <_NeoAstraFrontendClientInputDirectory Condition="'$(_NeoAstraFrontendClientInputDirectory)' == ''">$(NeoAstraFrontendClientPackageDirectory)</_NeoAstraFrontendClientInputDirectory>
    </PropertyGroup>
    <Error Condition="'$(_NeoAstraFrontendClientInputDirectory)' == '' or !Exists('$(_NeoAstraFrontendClientInputDirectory)/package.json') or !Exists('$(_NeoAstraFrontendClientInputDirectory)/dist/index.js')"
           Text="The packaged @neoastra/client runtime is unavailable. Restore a NeoAstra package containing tools/frontend/neoastra-client or build the source frontend package." />
    <ItemGroup>
      <_NeoAstraFrontendClientMetadata Include="$(_NeoAstraFrontendClientInputDirectory)/package.json;$(_NeoAstraFrontendClientInputDirectory)/LICENSE;$(_NeoAstraFrontendClientInputDirectory)/README.md;$(_NeoAstraFrontendClientInputDirectory)/provenance.json" />
      <_NeoAstraFrontendClientDist Include="$(_NeoAstraFrontendClientInputDirectory)/dist/**/*" />
    </ItemGroup>
    <RemoveDir Directories="$(NeoAstraFrontendClientStageDirectory)" />
    <MakeDir Directories="$(NeoAstraFrontendClientStageDirectory)/dist" />
    <Copy SourceFiles="@(_NeoAstraFrontendClientMetadata)" DestinationFolder="$(NeoAstraFrontendClientStageDirectory)" />
    <Copy SourceFiles="@(_NeoAstraFrontendClientDist)"
          DestinationFiles="@(_NeoAstraFrontendClientDist-&gt;'$(NeoAstraFrontendClientStageDirectory)/dist/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <NeoAstraFrontendInput Include="$(NeoAstraFrontendClientStageDirectory)/package.json;$(NeoAstraFrontendClientStageDirectory)/dist/**/*" />
      <FileWrites Include="$(NeoAstraFrontendClientStageDirectory)/**/*" />
    </ItemGroup>
  </Target>

  <Target Name="NeoAstraComputeFrontendFingerprint" DependsOnTargets="Compile;NeoAstraVerifyContracts;NeoAstraStageFrontendClient;NeoAstraRestoreFrontendPackages"
          Condition="'$(_NeoAstraPrepareFrontend)' == 'true'">
    <PropertyGroup>
      <NeoAstraFrontendIntermediateDirectory Condition="'$(NeoAstraFrontendIntermediateDirectory)' == ''">$(IntermediateOutputPath)neoastra/frontend</NeoAstraFrontendIntermediateDirectory>
      <NeoAstraFrontendFingerprint Condition="'$(NeoAstraFrontendFingerprint)' == ''">$(NeoAstraFrontendIntermediateDirectory)/inputs.sha256</NeoAstraFrontendFingerprint>
      <NeoAstraFrontendStamp Condition="'$(NeoAstraFrontendStamp)' == ''">$(NeoAstraFrontendIntermediateDirectory)/prepared.stamp</NeoAstraFrontendStamp>
      <NeoAstraAssetManifest Condition="'$(NeoAstraAssetManifest)' == ''">$(NeoAstraFrontendIntermediateDirectory)/neoastra-assets.json</NeoAstraAssetManifest>
      <NeoAstraAssetOutput Condition="'$(NeoAstraAssetOutput)' == ''">$(NeoAstraFrontendIntermediateDirectory)/assets</NeoAstraAssetOutput>
    </PropertyGroup>
    <ItemGroup>
      <_NeoAstraFrontendFingerprintInput Include="$(NeoRpcTypeScriptOutput)" Condition="Exists('$(NeoRpcTypeScriptOutput)')" />
      <_NeoAstraFrontendFingerprintInput Include="$(NeoRpcJavaScriptOutput)" Condition="Exists('$(NeoRpcJavaScriptOutput)')" />
      <_NeoAstraFrontendFingerprintInput Include="$(NeoRpcManifestOutput)" Condition="Exists('$(NeoRpcManifestOutput)')" />
      <_NeoAstraFrontendFingerprintInput Include="@(NeoAstraFrontendInput)" />
    </ItemGroup>
    <PropertyGroup>
      <_NeoAstraPrebuiltFingerprintArgument Condition="'$(NeoAstraPrebuiltAssets)' == 'true'">--prebuilt &quot;$(NeoAstraPrebuiltAssetDirectory)&quot;</_NeoAstraPrebuiltFingerprintArgument>
      <_NeoAstraFrontendFingerprintArguments>@(_NeoAstraFrontendFingerprintInput-&gt;'--input &quot;%(FullPath)&quot;', ' ')</_NeoAstraFrontendFingerprintArguments>
    </PropertyGroup>
    <Error Condition="'$(NeoAstraPrebuiltAssets)' == 'true' and '$(NeoAstraPrebuiltAssetDirectory)' == ''" Text="Prebuilt mode requires an explicit NeoAstraPrebuiltAssetDirectory." />
    <MakeDir Directories="$(NeoAstraFrontendIntermediateDirectory)" />
    <Exec Command="&quot;$(NeoAstraDotNetHost)&quot; exec &quot;$(NeoAstraToolPath)&quot; frontend fingerprint --config &quot;$(NeoAstraProjectConfig)&quot; --output &quot;$(NeoAstraFrontendFingerprint)&quot; --invalidate &quot;$(NeoAstraFrontendStamp)&quot; --configuration &quot;$(Configuration)&quot; $(_NeoAstraPrebuiltFingerprintArgument) $(_NeoAstraFrontendFingerprintArguments)" />
    <ItemGroup>
      <FileWrites Include="$(NeoAstraFrontendFingerprint)" />
    </ItemGroup>
  </Target>

  <Target Name="NeoAstraPrepareFrontend" DependsOnTargets="NeoAstraComputeFrontendFingerprint"
          Inputs="$(NeoAstraFrontendFingerprint)" Outputs="$(NeoAstraFrontendStamp);$(NeoAstraAssetManifest)"
          Condition="'$(_NeoAstraPrepareFrontend)' == 'true'">
    <PropertyGroup>
      <_NeoAstraPrebuiltArgument Condition="'$(NeoAstraPrebuiltAssets)' == 'true'">--prebuilt &quot;$(NeoAstraPrebuiltAssetDirectory)&quot;</_NeoAstraPrebuiltArgument>
      <_NeoAstraDevelopmentArgument Condition="'$(NeoAstraAllowDevelopmentSettingsInRelease)' == 'true'">--allow-development-settings</_NeoAstraDevelopmentArgument>
      <_NeoAstraDevUrlArgument Condition="'$(NeoAstraDevUrl)' != ''">--dev-url &quot;$(NeoAstraDevUrl)&quot;</_NeoAstraDevUrlArgument>
      <NeoAstraStaticFrontendOutput Condition="'$(NeoAstraStaticFrontendOutput)' == ''">$(NeoAstraFrontendIntermediateDirectory)/materialized</NeoAstraStaticFrontendOutput>
      <_NeoAstraStaticFrontendArgument Condition="'$(NeoAstraStaticFrontend)' == 'true' and '$(NeoAstraPrebuiltAssets)' != 'true'">--static-root &quot;$(NeoAstraStaticFrontendOutput)&quot;</_NeoAstraStaticFrontendArgument>
    </PropertyGroup>
    <ItemGroup Condition="'$(NeoAstraStaticFrontend)' == 'true' and '$(NeoAstraPrebuiltAssets)' != 'true'">
      <_NeoAstraStaticFrontendSource Include="$(NeoAstraStaticFrontendSourceDirectory)/**/*" />
      <_NeoAstraStaticFrontendClient Include="$(NeoAstraFrontendClientStageDirectory)/dist/*.js" Exclude="$(NeoAstraFrontendClientStageDirectory)/dist/testing.js" />
    </ItemGroup>
    <Error Condition="'$(NeoAstraStaticFrontend)' == 'true' and '$(NeoAstraPrebuiltAssets)' != 'true' and Exists('$(NeoAstraStaticFrontendSourceDirectory)/neoastra-client')"
           Text="The static frontend path 'neoastra-client' is SDK-owned; remove the copied client runtime from the project source." />
    <Error Condition="'$(NeoAstraStaticFrontend)' == 'true' and '$(NeoAstraPrebuiltAssets)' != 'true' and Exists('$(NeoRpcJavaScriptOutput)') and Exists('$(NeoAstraStaticFrontendSourceDirectory)/neoastra.js')"
           Text="The static frontend path 'neoastra.js' is generated by the NeoAstra SDK and must not exist in project source." />
    <RemoveDir Directories="$(NeoAstraStaticFrontendOutput)" Condition="'$(NeoAstraStaticFrontend)' == 'true' and '$(NeoAstraPrebuiltAssets)' != 'true'" />
    <MakeDir Directories="$(NeoAstraStaticFrontendOutput)/neoastra-client" Condition="'$(NeoAstraStaticFrontend)' == 'true' and '$(NeoAstraPrebuiltAssets)' != 'true'" />
    <Copy SourceFiles="@(_NeoAstraStaticFrontendSource)"
          DestinationFiles="@(_NeoAstraStaticFrontendSource-&gt;'$(NeoAstraStaticFrontendOutput)/%(RecursiveDir)%(Filename)%(Extension)')"
          Condition="'$(NeoAstraStaticFrontend)' == 'true' and '$(NeoAstraPrebuiltAssets)' != 'true'" />
    <Copy SourceFiles="@(_NeoAstraStaticFrontendClient)"
          DestinationFiles="@(_NeoAstraStaticFrontendClient-&gt;'$(NeoAstraStaticFrontendOutput)/neoastra-client/%(RecursiveDir)%(Filename)%(Extension)')"
          Condition="'$(NeoAstraStaticFrontend)' == 'true' and '$(NeoAstraPrebuiltAssets)' != 'true'" />
    <Copy SourceFiles="$(NeoRpcJavaScriptOutput)" DestinationFiles="$(NeoAstraStaticFrontendOutput)/neoastra.js"
          Condition="'$(NeoAstraStaticFrontend)' == 'true' and '$(NeoAstraPrebuiltAssets)' != 'true' and Exists('$(NeoRpcJavaScriptOutput)')" />
    <Exec Command="&quot;$(NeoAstraDotNetHost)&quot; exec &quot;$(NeoAstraToolPath)&quot; assets --config &quot;$(NeoAstraProjectConfig)&quot; --manifest &quot;$(NeoAstraAssetManifest)&quot; --copy &quot;$(NeoAstraAssetOutput)&quot; $(_NeoAstraPrebuiltArgument) $(_NeoAstraStaticFrontendArgument) $(_NeoAstraDevelopmentArgument) $(_NeoAstraDevUrlArgument)" />
    <Touch Files="$(NeoAstraFrontendStamp)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(NeoAstraFrontendStamp);$(NeoAstraAssetManifest);$(NeoAstraStaticFrontendOutput)/**/*" />
    </ItemGroup>
  </Target>

  <Target Name="NeoAstraReadPreparedFrontend" DependsOnTargets="NeoAstraPrepareFrontend"
          Condition="'$(_NeoAstraPrepareFrontend)' == 'true'">
    <ItemGroup>
      <_NeoAstraAssetFile Include="$(NeoAstraAssetOutput)/**/*" Exclude="$(NeoAstraAssetOutput)/neoastra-assets.json" />
      <_NeoAstraAssetManifestFile Include="$(NeoAstraAssetOutput)/neoastra-assets.json" />
      <FileWrites Include="@(_NeoAstraAssetFile);@(_NeoAstraAssetManifestFile)" />
    </ItemGroup>
  </Target>

  <Target Name="NeoAstraCopyFrontendToOutput" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="NeoAstraReadPreparedFrontend"
          Inputs="$(NeoAstraFrontendStamp)" Outputs="$(OutDir)assets/neoastra-assets.json"
          Condition="'$(_NeoAstraPrepareFrontend)' == 'true'">
    <RemoveDir Directories="$(OutDir)assets" />
    <Copy SourceFiles="@(_NeoAstraAssetFile)" DestinationFiles="@(_NeoAstraAssetFile-&gt;'$(OutDir)assets/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_NeoAstraAssetManifestFile)" DestinationFiles="@(_NeoAstraAssetManifestFile-&gt;'$(OutDir)assets/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="$(OutDir)assets/**/*" />
    </ItemGroup>
  </Target>

  <Target Name="NeoAstraAddAssetsToPublish" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="NeoAstraReadPreparedFrontend"
          Condition="'$(_NeoAstraPrepareFrontend)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_NeoAstraAssetFile);@(_NeoAstraAssetManifestFile)">
        <RelativePath>assets/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="NeoAstraInspect">
    <Exec Command="&quot;$(NeoAstraDotNetHost)&quot; exec &quot;$(NeoAstraToolPath)&quot; inspect --config &quot;$(NeoAstraProjectConfig)&quot;" />
  </Target>
</Project>
