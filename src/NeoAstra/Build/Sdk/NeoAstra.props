<Project>
  <PropertyGroup>
    <NeoAstraProjectConfig Condition="'$(NeoAstraProjectConfig)' == ''">$(MSBuildProjectDirectory)/neoastra.json</NeoAstraProjectConfig>
    <NeoAstraFrontendEnabled Condition="'$(NeoAstraFrontendEnabled)' == '' and (Exists('$(NeoAstraProjectConfig)') or Exists('$(MSBuildProjectDirectory)/ClientApp/package.json'))">true</NeoAstraFrontendEnabled>
    <NeoAstraFrontendEnabled Condition="'$(NeoAstraFrontendEnabled)' == ''">false</NeoAstraFrontendEnabled>
    <NeoAstraBuildFrontend Condition="'$(NeoAstraBuildFrontend)' == ''">true</NeoAstraBuildFrontend>
    <NeoAstraRestoreFrontendDependencies Condition="'$(NeoAstraRestoreFrontendDependencies)' == ''">true</NeoAstraRestoreFrontendDependencies>
    <NeoAstraPrebuiltAssets Condition="'$(NeoAstraPrebuiltAssets)' == ''">false</NeoAstraPrebuiltAssets>
    <NeoAstraToolPath Condition="'$(NeoAstraToolPath)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\NeoAstra.Tool\NeoAstra.Tool.csproj')">$(MSBuildThisFileDirectory)..\..\..\NeoAstra.Tool\bin\$(Configuration)\net10.0\NeoAstra.Tool.dll</NeoAstraToolPath>
    <NeoAstraToolPath Condition="'$(NeoAstraToolPath)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\any\NeoAstra.Tool.dll</NeoAstraToolPath>
    <NeoAstraDotNetHost Condition="'$(NeoAstraDotNetHost)' == ''">dotnet</NeoAstraDotNetHost>
    <NeoRpcIntermediateOutputPath Condition="'$(NeoRpcIntermediateOutputPath)' == ''">$(MSBuildProjectExtensionsPath)neoastra</NeoRpcIntermediateOutputPath>
    <NeoRpcTypeScriptOutput Condition="'$(NeoRpcTypeScriptOutput)' == ''">$(NeoRpcIntermediateOutputPath)/neoastra.ts</NeoRpcTypeScriptOutput>
    <NeoRpcJavaScriptImport Condition="'$(NeoRpcJavaScriptImport)' == ''">@neoastra/client</NeoRpcJavaScriptImport>
    <NeoRpcManifestOutput Condition="'$(NeoRpcManifestOutput)' == ''">$(NeoRpcIntermediateOutputPath)/neoastra.manifest.json</NeoRpcManifestOutput>
    <NeoRpcSchemaOutput Condition="'$(NeoRpcSchemaOutput)' == ''">$(NeoRpcIntermediateOutputPath)/neoastra.schema.json</NeoRpcSchemaOutput>
  </PropertyGroup>
</Project>
