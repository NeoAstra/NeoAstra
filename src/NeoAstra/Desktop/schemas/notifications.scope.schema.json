{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoastra.dev/schemas/desktop/notifications.scope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["appIdentity", "categories", "maximumPayloadBytes", "persistent", "urgencies"],
  "properties": {
    "appIdentity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "categories": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" } },
    "maximumPayloadBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "persistent": { "type": "boolean" },
    "urgencies": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["low", "normal", "high"] } }
  }
}
