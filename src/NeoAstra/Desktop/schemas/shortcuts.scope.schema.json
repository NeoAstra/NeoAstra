{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoastra.dev/schemas/desktop/shortcuts.scope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["accelerators"],
  "properties": {
    "accelerators": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:(?:Ctrl|Alt|Shift|Meta)\\+){0,4}[A-Za-z0-9_-]{1,16}$", "maxLength": 64 } }
  }
}
