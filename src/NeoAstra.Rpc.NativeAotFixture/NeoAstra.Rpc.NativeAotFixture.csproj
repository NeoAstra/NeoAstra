<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NeoRpcTypeScriptOutput>$(MSBuildProjectDirectory)/generated/neoastra.ts</NeoRpcTypeScriptOutput>
    <NeoRpcManifestOutput>$(MSBuildProjectDirectory)/generated/neoastra.manifest.json</NeoRpcManifestOutput>
    <NeoRpcSchemaOutput>$(MSBuildProjectDirectory)/generated/neoastra.schema.json</NeoRpcSchemaOutput>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="NeoRpcTypeScriptOutput" />
    <CompilerVisibleProperty Include="NeoRpcManifestOutput" />
    <CompilerVisibleProperty Include="NeoRpcSchemaOutput" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NeoAstra\NeoAstra.csproj" />
    <ProjectReference Include="..\NeoAstra.Generator\NeoAstra.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
