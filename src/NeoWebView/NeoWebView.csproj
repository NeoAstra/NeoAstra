<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <!-- Enable AOT analyzers -->
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Build native desktop apps with web technologies.</Description>
    <Copyright>Alexandre Mutel</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Authors>Alexandre Mutel</Authors>
    <PackageTags>webview;webapp</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>NeoWebView.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageProjectUrl>https://github.com/xoofx/NeoWebView</PackageProjectUrl>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <!--Add support for sourcelink-->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../img/NeoWebView.png" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../readme.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/windows-x64-release/neowebview_native.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/neowebview_native.dll" Condition="Exists('$(MSBuildThisFileDirectory)../../artifacts/native/windows-x64-release/neowebview_native.dll')" />
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/windows-arm64-release/neowebview_native.dll"
          Pack="true" PackagePath="runtimes/win-arm64/native/neowebview_native.dll" Condition="Exists('$(MSBuildThisFileDirectory)../../artifacts/native/windows-arm64-release/neowebview_native.dll')" />
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/macos-x64-release/libneowebview_native.dylib"
          Pack="true" PackagePath="runtimes/osx-x64/native/libneowebview_native.dylib" Condition="Exists('$(MSBuildThisFileDirectory)../../artifacts/native/macos-x64-release/libneowebview_native.dylib')" />
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/macos-arm64-release/libneowebview_native.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/libneowebview_native.dylib" Condition="Exists('$(MSBuildThisFileDirectory)../../artifacts/native/macos-arm64-release/libneowebview_native.dylib')" />
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/linux-x64-release/libneowebview_native.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/libneowebview_native.so" Condition="Exists('$(MSBuildThisFileDirectory)../../artifacts/native/linux-x64-release/libneowebview_native.so')" />
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/linux-arm64-release/libneowebview_native.so"
          Pack="true" PackagePath="runtimes/linux-arm64/native/libneowebview_native.so" Condition="Exists('$(MSBuildThisFileDirectory)../../artifacts/native/linux-arm64-release/libneowebview_native.so')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
