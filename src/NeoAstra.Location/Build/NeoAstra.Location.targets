<Project>
  <!-- The location plugin gives an Android application the Java side of its service: the package keeps it beside its build files,
       and a project reference finds it in the sources of the plugin. -->
  <PropertyGroup>
    <NeoAstraLocationJavaDirectory Condition="'$(NeoAstraLocationJavaDirectory)' == '' And Exists('$(MSBuildThisFileDirectory)../java/')">$(MSBuildThisFileDirectory)../java/</NeoAstraLocationJavaDirectory>
    <NeoAstraLocationJavaDirectory Condition="'$(NeoAstraLocationJavaDirectory)' == ''">$(MSBuildThisFileDirectory)../Android/</NeoAstraLocationJavaDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidJavaSource Include="$(NeoAstraLocationJavaDirectory)com/neoastra/location/*.java" />
    <AndroidManifestOverlay Include="$(NeoAstraLocationJavaDirectory)AndroidManifest.xml" />
  </ItemGroup>
</Project>
