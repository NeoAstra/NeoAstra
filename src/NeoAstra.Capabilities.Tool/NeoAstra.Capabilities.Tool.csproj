<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>neoastra-capabilities</ToolCommandName>
    <PackageId>NeoAstra.Capabilities.Tool</PackageId>
    <Description>Deterministic build-time validation and resolution for NeoAstra capability manifests.</Description>
    <PackageReadmeFile>capabilities-and-security.md</PackageReadmeFile>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/xoofx/NeoAstra</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NeoAstra.Rpc\NeoAstra.Rpc.csproj" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <None Include="$(MSBuildThisFileDirectory)../../license.txt" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../doc/capabilities-and-security.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../schemas/neoastra-capabilities-v1.schema.json" Pack="true" PackagePath="schemas/" />
  </ItemGroup>
</Project>
