<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>neoastra</ToolCommandName>
    <PackageId>NeoAstra.Tool</PackageId>
    <Description>Development and delivery CLI for NeoAstra desktop apps. Run frontend development workflows, validate assets and capabilities, and prepare application bundles and update metadata.</Description>
    <PackageTags>neoastra;desktop;cli;dotnet-tool;frontend;development;packaging</PackageTags>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/NeoAstra/NeoAstra</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>frontend-tooling-and-assets.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DefineConstants>$(DefineConstants);NEOASTRA_TOOL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the tool standalone by compiling only the shared models and validation it uses. -->
    <Compile Include="..\NeoAstra.Core\NeoAssetManifest.cs" Link="Shared\NeoAssetManifest.cs" />
    <Compile Include="..\NeoAstra.Core\Interop\NeoNativeAbi.cs" Link="Shared\NeoNativeAbi.cs" />
    <Compile Include="..\NeoAstra\Rpc\NeoCapabilities.cs" Link="Shared\NeoCapabilities.cs" />
    <Compile Include="..\NeoAstra\Rpc\NeoCapabilityScopes.cs" Link="Shared\NeoCapabilityScopes.cs" />
    <Compile Include="..\NeoAstra\Rpc\NeoRpcValidation.cs" Link="Shared\NeoRpcValidation.cs" />
    <Compile Include="..\NeoAstra\Rpc\NeoSecurity.cs" Link="Shared\NeoSecurity.cs" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="XenoAtom.CommandLine" />
    <None Include="$(MSBuildThisFileDirectory)../../license.txt" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../schemas/neoastra-project-v1.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="$(MSBuildThisFileDirectory)../../schemas/neoastra-staging-manifest-v1.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="$(MSBuildThisFileDirectory)../../schemas/neoastra-update-manifest-v1.schema.json" Pack="true" PackagePath="schemas/" />
    <None Include="$(MSBuildThisFileDirectory)../../doc/frontend-tooling-and-assets.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../doc/delivery-and-updates.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="NeoAstraExcludeNativeRuntimeFromTool" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'neoastra_native' or '%(Filename)' == 'libneoastra_native' or '%(Filename)' == 'neoastra-native'" />
      <_NeoAstraStaleNativeToolFile Include="$(PublishDir)neoastra_native.*;$(PublishDir)libneoastra_native.*;$(PublishDir)neoastra-native.json" />
    </ItemGroup>
    <Delete Files="@(_NeoAstraStaleNativeToolFile)" />
  </Target>
</Project>
