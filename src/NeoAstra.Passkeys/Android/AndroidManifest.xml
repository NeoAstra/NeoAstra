<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the manifest of an Android application that references the Credential Manager: the provider adds the passkeys
     service to the platform services of NeoAstra when the process starts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <provider
        android:name="com.neoastra.passkeys.NeoAstraPasskeysInitializer"
        android:authorities="${applicationId}.neoastra.passkeys"
        android:exported="false" />
  </application>
</manifest>
