{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoastra.dev/schemas/neoastra-update-manifest-v1.schema.json",
  "title": "NeoAstra canonical signed update manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "applicationId", "channel", "version", "build", "releasedAt", "minimumUpdaterVersion", "minimumAppVersion", "maximumAppVersion", "signingKeyId", "artifacts", "rolloutPercent", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "applicationId": { "type": "string", "minLength": 1, "maxLength": 255 },
    "channel": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": { "$ref": "#/$defs/version" },
    "build": { "type": "integer", "minimum": 0 },
    "releasedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "minimumUpdaterVersion": { "$ref": "#/$defs/version" },
    "minimumAppVersion": { "$ref": "#/$defs/version" },
    "maximumAppVersion": { "$ref": "#/$defs/version" },
    "signingKeyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/artifact" } },
    "rolloutPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "releaseNotesUrl": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
    "signature": { "type": "string", "minLength": 88, "maxLength": 108 }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 64 },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["rid", "url", "length", "sha256", "format", "signature"],
      "properties": {
        "rid": { "enum": ["win-x64", "win-arm64", "osx-x64", "osx-arm64", "linux-x64", "linux-arm64"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "length": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "format": { "enum": ["zip", "msix", "dmg", "pkg", "tar.gz", "deb"] },
        "signature": { "type": "string", "minLength": 88, "maxLength": 108 }
      }
    }
  }
}
