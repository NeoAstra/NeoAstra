{
  "name": "neoastra-frontend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @neoastra/client",
    "test": "npm run build && node --test packages/client/test/*.test.mjs",
    "check:size": "node tools/check-size.mjs",
    "check:package": "node tools/check-package.mjs && node tools/check-licenses.mjs",
    "check:fixtures": "node tools/build-fixtures.mjs && node tools/generate-templates.mjs --check",
    "check": "npm test && npm run check:size && npm run check:package && npm run check:fixtures"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-vue": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "8.2.0",
    "vue": "latest"
  }
}
